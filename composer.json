{
    "name": "survos/imagor-bundle",
    "description": "Symfony bundle for signed imagor URLs (presets, crops, meta) against the Survos imagor build",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "imagor",
        "image",
        "resize",
        "thumbnail",
        "thumbhash",
        "blurhash"
    ],
    "autoload": {
        "psr-4": {
            "Survos\\ImagorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\ImagorBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-client-contracts": "^3.5",
        "symfony/http-kernel": "^8.1",
        "survos/kit-bundle": "^2.5",
        "twig/twig": "^3.14|^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/http-client": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/twig-bundle": "^8.1"
    },
    "extra": {
        "symfony": {
            "require": "^8.1"
        }
    }
}
